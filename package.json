{
  "name": "@aiwerk/mcp-server-elevenlabs",
  "version": "0.1.1",
  "description": "ElevenLabs MCP server. 390 tools generated from the live ElevenLabs OpenAPI specification, with file uploads and audio downloads.",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "mcp-server-elevenlabs": "dist/src/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "gen-naming": "node scripts/gen-naming.mjs",
    "gen-tools": "node scripts/generate-tools.mjs",
    "regen": "npm run gen-naming && npm run gen-tools",
    "prebuild": "npm run gen-version",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "predev": "npm run gen-version",
    "dev": "tsc --watch",
    "pretest": "npm run gen-version && bash -c 'pkill -9 -f \"[m]cp-server-elevenlabs/node_modules/.*vitest\" 2>/dev/null; pkill -9 -f \"[m]cp-server-elevenlabs/node_modules/.*esbuild.*--service\" 2>/dev/null; true'",
    "test": "vitest run",
    "posttest": "bash -c 'pkill -9 -f \"[m]cp-server-elevenlabs/node_modules/.*vitest\" 2>/dev/null; pkill -9 -f \"[m]cp-server-elevenlabs/node_modules/.*esbuild.*--service\" 2>/dev/null; true'",
    "smoke": "node scripts/live-smoke.mjs",
    "prepublishOnly": "bash scripts/prepublish-safety.sh && npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "elevenlabs",
    "aiwerk",
    "text-to-speech",
    "tts",
    "speech-to-text",
    "voice-cloning",
    "dubbing"
  ],
  "author": "AIWerk <kontakt@aiwerk.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIWerk/mcp-server-elevenlabs.git"
  },
  "homepage": "https://aiwerkmcp.com",
  "bugs": {
    "url": "https://github.com/AIWerk/mcp-server-elevenlabs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.1"
  }
}
